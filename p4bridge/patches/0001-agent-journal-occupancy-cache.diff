+/// What the last directory walk found, and what has been charged since.
+///
+/// `occupied_bytes` used to walk the whole journal root and `lstat` every
+/// entry, and `require_capacity` calls it before every single write. Nothing
+/// is ever removed from a journal, so that walk got longer with every record
+/// the agent had ever written: measured on a live ring, padding the directory
+/// with 20,000 zero-byte entries — which charge nothing at all against the
+/// budget — took decode from 9.5 to 2.2 tokens per second, and removing them
+/// put it back. The walk, not the bytes and not the fsync, was the cost.
+///
+/// One agent holds the journal root exclusively — a second agent pointed at the
+/// same directory fails to start — so no other process adds bytes behind this
+/// count. Within the process a root may have several handles, and they must not
+/// each keep their own idea of how full it is, so the count is shared per root.
+#[derive(Default)]
+struct Occupancy {
+    /// Bytes the last exact walk found, if one has run.
+    scanned: Option<u64>,
+    /// An upper bound on what has been written since that walk.
+    charged_since: u64,
+}
+
+/// Occupancy per journal root, shared by every handle open on it.
+fn occupancy_for(root: &Path) -> Arc<Mutex<Occupancy>> {
+    static ROOTS: OnceLock<Mutex<HashMap<PathBuf, Arc<Mutex<Occupancy>>>>> = OnceLock::new();
+    let key = fs::canonicalize(root).unwrap_or_else(|_| root.to_path_buf());
+    Arc::clone(
+        ROOTS
+            .get_or_init(|| Mutex::new(HashMap::new()))
+            .lock()
+            .unwrap_or_else(|error| error.into_inner())
+            .entry(key)
+            .or_default(),
+    )
+}
