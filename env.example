# Build settings for the native node runtime (apps/, src/) — the C++ the mobile
# node apps compile in. The retired Docker control plane is gone; the gateway
# has its own env at solana/staking-service/.env (see DEPLOY_GATE.md).

MODELS_DIR=./models
CUDA_ARCHS=75;80;86;89;90;120;121
KVR_BUILD_JOBS=4
