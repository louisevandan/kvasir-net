MODELS_DIR=./models
# On Linux with NVIDIA Container Toolkit:
# docker compose -f docker-compose.yml -f docker-compose.cuda.yml up -d --build
# Docker Desktop on macOS cannot expose Metal to containers. Start the portable
# hub, then run the native Metal node agent.
CUDA_ARCHS=75;80;86;89;90;120;121
LINKCPP_BUILD_JOBS=4
LINKCPP_CUDA_TOOLCHAIN_IMAGE=linkcpp-cuda-toolchain:local
LINKCPP_LLAMA_BUILD_IMAGE=linkcpp-llama-build:local
LINKCPP_RPC_ARTIFACT_IMAGE=linkcpp-rpc-artifacts:local
LINKCPP_PROXY_ARTIFACT_IMAGE=linkcpp-proxy-artifacts:local
LINKCPP_CUDA_RUNTIME_IMAGE=nvidia/cuda:13.0.0-runtime-ubuntu22.04
LINKCPP_UI_PORT=19000
LINKCPP_MAX_NODES=5

# Native managed node-agent examples.
LINKCPP_LLAMA_CPP_BACKEND=auto
LINKCPP_NODE_AGENT_PORT=9101
LINKCPP_RPC_PORT=50052
LINKCPP_VRAM_BUDGET=24
LINKCPP_RAM_BUDGET=64
LINKCPP_CORES=12
