# Compatibility patches are hashed by raw bytes in the manifest; pin them to
# canonical LF so a fresh checkout is identical under any core.autocrlf.
*.patch text eol=lf whitespace=-blank-at-eol,-blank-at-eof
# Release manifests are hashed as raw bytes across Windows checkouts.
*.sha256 text eol=lf
SHA256SUMS text eol=lf

layers/adapters/hf/** text eol=lf
