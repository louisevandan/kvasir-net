# Kvasir gateway deployment config. Copy to `.env` and edit, then `docker compose up -d --build`.

# Host port to expose the gateway on (container always listens on 8791).
GATEWAY_PORT=8791

# Solana RPC. Keep devnet for now; switch to a mainnet RPC only with a mainnet token+key.
LINKCPP_RPC_URL=https://api.devnet.solana.com

# Node-operator economics.
STAKING_APR=0.12
# Extra reward multiplier for a node that hosts the gateway (1.5 = +50%).
KVR_GATEWAY_BONUS=1.5

# The canonical public URL clients point at (returned by /api/config). Set to your
# server's address, e.g. https://gw.example.com or http://203.0.113.10:8791
KVR_PUBLIC_URL=

# Settlement admin key — choose ONE:
#  (a) mounted file: put the JSON key at ./secrets/admin.json (docker-compose mounts it). Leave this blank.
#  (b) inline: paste the secret key JSON array here (then remove the secrets volume in docker-compose.yml).
#      KVR_ADMIN_KEY=[12,34,...]
KVR_ADMIN_KEY=
