{
  "name": "linkcpp-wallet-desktop",
  "version": "0.1.0",
  "description": "Kvasir non-custodial KVR wallet + node dashboard for Windows/macOS/Linux desktop",
  "author": "kvasir-ai.net",
  "license": "MIT",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev:web": "vite",
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env ELECTRON_DEV=1 electron .\"",
    "build:web": "vite build",
    "build": "vite build",
    "build:win": "vite build && electron-builder --win --x64",
    "build:mac": "vite build && electron-builder --mac",
    "build:linux": "vite build && electron-builder --linux --x64",
    "typecheck": "tsc --noEmit"
  },
  "overrides": {
    "uuid": "9.0.1"
  },
  "dependencies": {
    "@noble/ciphers": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "bs58": "^4.0.1",
    "@solana/spl-token": "^0.4.9",
    "@solana/web3.js": "^1.95.4",
    "@solana/codecs-core": "2.0.0-rc.1",
    "@solana/codecs-data-structures": "2.0.0-rc.1",
    "@solana/codecs-numbers": "2.0.0-rc.1",
    "@solana/codecs-strings": "2.0.0-rc.1",
    "@solana/spl-token-group": "0.0.7",
    "@solana/spl-token-metadata": "0.1.6",
    "bip39": "^3.1.0",
    "ed25519-hd-key": "^1.3.0",
    "react-markdown": "^9.1.0",
    "remark-gfm": "^4.0.1",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^32.1.2",
    "electron-builder": "^25.1.7",
    "esbuild": "^0.28.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "typescript": "^5.5.4",
    "vite": "^5.4.8",
    "vite-plugin-node-polyfills": "^0.28.0",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "ai.banya.linkcpp.desktop",
    "productName": "Kvasir Wallet",
    "artifactName": "Kvasir-Wallet-${version}-${os}-${arch}.${ext}",
    "afterPack": "scripts/afterPack.cjs",
    "npmRebuild": false,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/**/*"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.finance",
      "identity": null
    },
    "dmg": {
      "title": "Kvasir Wallet ${version}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Finance"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "extraResources": [
      {
        "from": "../../solana/staking-service",
        "to": "gateway",
        "filter": [
          "**/*",
          "!data/**",
          "!.env",
          "!**/*.node",
          "!**/*.o",
          "!**/*.a",
          "!**/prebuilds/**",
          "!**/build/**",
          "!node_modules/@typescript/**",
          "!node_modules/typescript/**",
          "!node_modules/.bin/**"
        ]
      },
      {
        "from": "../shared-spec/token.devnet.json",
        "to": "gateway-spec/token.devnet.json"
      }
    ]
  }
}
