diff --git a/src/llama-graph.cpp b/src/llama-graph.cpp
index f868a899318f59926dfc565bfbcd00441885e3dd..67a076b8558825fa742ed9e82d3727f47303b72a 100644
--- a/src/llama-graph.cpp
+++ b/src/llama-graph.cpp
@@ -1491,6 +1491,12 @@ bool llm_graph_result::apply_linkcpp_stage(const llm_graph_params & params) {
     const int begin = params.linkcpp_layer_begin;
     const int end   = params.linkcpp_layer_end;
     const int n_layer = params.hparams.n_layer();
+    // The MTP context executes the auxiliary NextN graph entirely on the
+    // tail stage. It is not a slice of the target trunk and therefore has no
+    // inter-stage cut-set to prune or bind.
+    if (params.gtype == LLM_GRAPH_TYPE_DECODER_MTP) {
+        return true;
+    }
     if (begin < 0 || end < 0) {
         return true;
     }
