--- a/src/llama-ext.h
+++ b/src/llama-ext.h
@@ -90,6 +90,11 @@
 
 LLAMA_API llama_memory_breakdown llama_get_memory_breakdown(const struct llama_context * ctx);
 
+// Default repeating-layer placement only. Tensor overrides, KV and operator
+// fallback placement are separate contracts. Available in no-alloc and real loads.
+#define LLAMA_LINKCPP_LAYER_DEVICE_QUERY 1
+LLAMA_API ggml_backend_dev_t llama_model_get_layer_device(const struct llama_model * model, int32_t layer);
