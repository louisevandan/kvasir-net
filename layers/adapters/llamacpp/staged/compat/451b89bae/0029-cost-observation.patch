diff --git a/src/llama-graph.h b/src/llama-graph.h
--- a/src/llama-graph.h
+++ b/src/llama-graph.h
@@ -13,6 +13,49 @@
 #include <functional>
 #include <map>
 #include <unordered_map>
+#include <atomic>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#ifdef _WIN32
+#include <process.h>
+#else
+#include <unistd.h>
+#endif
+
+namespace llama_linkcpp_cost {
+inline bool enabled() {
+    static const bool value = [] {
+        const auto * p = std::getenv("P4_STAGED_TRACE_COST");
+        return p && std::strcmp(p, "1") == 0;
+    }();
+    return value;
+}
+inline long pid() {
+#ifdef _WIN32
+    return _getpid();
+#else
+    return getpid();
+#endif
+}
+inline std::atomic<uint64_t> next_graph{1};
+inline thread_local uint64_t graph_id = 0;
+inline thread_local const void * context = nullptr;
+struct Scope {
+    const bool traced = enabled();
+    uint64_t previous_graph = graph_id;
+    const void * previous_context = context;
+    int64_t started = 0;
+    explicit Scope(const void * ctx) {
+        if (!traced) return;
+        graph_id = next_graph.fetch_add(1, std::memory_order_relaxed);
+        context = ctx; started = ggml_time_us();
+        std::fprintf(stderr, "P4_COST_GRAPH_BEGIN pid=%ld ctx=%llx graph=%llu\n", pid(),
+            (unsigned long long) (uintptr_t) context, (unsigned long long) graph_id);
+    }
+    ~Scope() { if (traced) { graph_id = previous_graph; context = previous_context; } }
+};
+} // namespace llama_linkcpp_cost
 
