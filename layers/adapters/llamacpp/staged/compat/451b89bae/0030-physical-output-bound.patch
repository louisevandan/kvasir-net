+bool llm_graph_result::get_linkcpp_output_payload_bound(uint64_t & bytes, uint32_t & tensors) const {
+    bytes = 0;
+    tensors = 0;
+
+    if (t_linkcpp_outputs.size() > std::numeric_limits<uint32_t>::max()) {
+        return false;
+    }
+    tensors = (uint32_t) t_linkcpp_outputs.size();
+
+    const auto storage = [](const ggml_tensor * tensor) {
+        uint64_t offset = 0;
+        while (tensor && tensor->view_src) {
+            if (offset > std::numeric_limits<uint64_t>::max() - tensor->view_offs) {
+                return std::pair<const ggml_tensor *, uint64_t>{ nullptr, 0 };
+            }
+            offset += tensor->view_offs;
+            tensor = tensor->view_src;
+        }
+        return std::pair<const ggml_tensor *, uint64_t>{ tensor, offset };
+    };
+
+    for (size_t i = 0; i < t_linkcpp_outputs.size(); ++i) {
+        const ggml_tensor * tensor = t_linkcpp_outputs[i];
+        if (!tensor) {
+            return false;
+        }
+        const auto tensor_storage = storage(tensor);
+        if (!tensor_storage.first) {
+            return false;
+        }
+
+        bool alias = false;
+        for (size_t j = 0; j < i; ++j) {
+            const ggml_tensor * other = t_linkcpp_outputs[j];
+            if (tensor_storage == storage(other)
+                && tensor->type == other->type
+                && ggml_are_same_shape(tensor, other)
+                && memcmp(tensor->nb, other->nb, sizeof(tensor->nb)) == 0) {
+                alias = true;
+                break;
+            }
+        }
+        if (alias) {
+            continue;
+        }
+
+        const size_t nbytes = ggml_nbytes(tensor);
+        if (nbytes > std::numeric_limits<uint64_t>::max() - bytes) {
+            return false;
+        }
+        bytes += nbytes;
+    }
+    return true;
+}
