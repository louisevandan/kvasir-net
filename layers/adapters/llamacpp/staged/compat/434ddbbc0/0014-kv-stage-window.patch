-            dev_name = ggml_backend_dev_name(dev);
+        const bool linkcpp_owned = model.linkcpp_layer_begin() < 0 ||
+            (model.linkcpp_layer_begin() <= (int32_t) il &&
+             (int32_t) il < model.linkcpp_layer_end());
+        const int32_t kv_gpu_layer_start = model.linkcpp_kv_gpu_layer_start();
+        const int32_t kv_gpu_layer_end = model.linkcpp_kv_gpu_layer_end();
+        const bool managed_kv = kv_gpu_layer_start >= 0 &&
