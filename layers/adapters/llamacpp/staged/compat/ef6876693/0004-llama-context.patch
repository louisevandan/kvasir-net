+static std::pair<const ggml_tensor *, uint64_t> linkcpp_tensor_storage(const ggml_tensor * tensor) {
+    uint64_t offset = 0;
+    while (tensor && tensor->view_src) {
+        offset += tensor->view_offs;
+        tensor = tensor->view_src;
+    }
+    return { tensor, offset };
+}
+
+static bool linkcpp_tensor_desc(
+        const ggml_tensor * tensor,
+        const std::vector<ggml_tensor *> & tensors,
+        int32_t index,
+        llama_linkcpp_tensor_desc * desc) {
+    if (!tensor || !desc) return false;
+    memset(desc, 0, sizeof(*desc));
+    desc->type = (int32_t) tensor->type;
+    desc->n_dims = ggml_n_dims(tensor);
+    memcpy(desc->ne, tensor->ne, sizeof(desc->ne));
+    memcpy(desc->nb, tensor->nb, sizeof(desc->nb));
+    desc->nbytes = ggml_nbytes(tensor);
+    const auto storage = linkcpp_tensor_storage(tensor);
+    desc->view_offset = storage.second;
+    desc->alias_of = -1;
+    for (int32_t i = 0; i < index; ++i) {
+        const ggml_tensor * other = tensors[i];
+        const auto other_storage = linkcpp_tensor_storage(other);
+        if (storage == other_storage
+            && tensor->type == other->type
+            && ggml_are_same_shape(tensor, other)
+            && memcmp(tensor->nb, other->nb, sizeof(tensor->nb)) == 0) {
+            desc->alias_of = i;
+            break;
+        }
+    }
+    snprintf(desc->name, sizeof(desc->name), "%s", ggml_get_name(tensor));
+    return true;
+}
