+
+bool llama_context::linkcpp_input_desc(int32_t index, llama_linkcpp_tensor_desc * desc) const {
+    const auto & tensors = gf_res_prev->get_linkcpp_inputs();
+    return index >= 0 && index < (int32_t) tensors.size()
+        && linkcpp_tensor_desc(tensors[index], tensors, index, desc);
+}
+
+bool llama_context::linkcpp_output_desc(int32_t index, llama_linkcpp_tensor_desc * desc) const {
+    const auto & tensors = gf_res_prev->get_linkcpp_outputs();
+    return index >= 0 && index < (int32_t) tensors.size()
+        && linkcpp_tensor_desc(tensors[index], tensors, index, desc);
+}
+
+bool llama_context::linkcpp_terminal_desc(int32_t index, llama_linkcpp_tensor_desc * desc) const {
+    const auto & tensors = gf_res_prev->get_linkcpp_terminals();
+    return index >= 0 && index < (int32_t) tensors.size()
+        && linkcpp_tensor_desc(tensors[index], tensors, index, desc);
+}
+
+bool llama_context::linkcpp_input_set(int32_t index, const void * data, size_t size) {
+    if (index < 0 || !data) return false;
+    if (linkcpp_input_payloads.size() <= (size_t) index) {
+        linkcpp_input_payloads.resize((size_t) index + 1);
+    }
+    linkcpp_input_payloads[index].assign((const uint8_t *) data, (const uint8_t *) data + size);
+    linkcpp_input_payload_descs.clear();
+    return true;
+}
+
+bool llama_context::linkcpp_input_set_tensor(
+        const llama_linkcpp_tensor_desc * desc, const void * data, size_t size) {
+    if (!desc || !data || size != desc->nbytes) return false;
+    linkcpp_input_payload_descs.push_back(*desc);
+    linkcpp_input_payloads.emplace_back(
+        (const uint8_t *) data, (const uint8_t *) data + size);
+    return true;
+}
+
+void llama_context::linkcpp_input_clear() {
+    linkcpp_input_payloads.clear();
+    linkcpp_input_payload_descs.clear();
+}
+
+bool llama_context::linkcpp_output_get(int32_t index, void * data, size_t size) const {
+    const auto & tensors = gf_res_prev->get_linkcpp_outputs();
+    if (index < 0 || index >= (int32_t) tensors.size() || !data
+        || size != ggml_nbytes(tensors[index]) || tensors[index]->buffer == nullptr) return false;
+    ggml_backend_t backend = ggml_backend_sched_get_tensor_backend(sched.get(), tensors[index]);
+    if (!backend) return false;
+    ggml_backend_tensor_get_async(backend, tensors[index], data, 0, size);
+    return true;
+}
+
+bool llama_context::linkcpp_output_synchronize() const {
+    ggml_backend_sched_synchronize(sched.get());
+    return true;
+}
+
+bool llama_context::linkcpp_terminal_get(int32_t index, void * data, size_t size) const {
+    const auto & tensors = gf_res_prev->get_linkcpp_terminals();
+    if (index < 0 || index >= (int32_t) tensors.size() || !data
+        || size != ggml_nbytes(tensors[index]) || tensors[index]->buffer == nullptr) return false;
+    ggml_backend_sched_synchronize(sched.get());
+    ggml_backend_tensor_get(tensors[index], data, 0, size);
+    return true;
+}
+
+bool llama_context::linkcpp_terminal_set(int32_t index, const void * data, size_t size) {
+    const auto & tensors = gf_res_prev->get_linkcpp_terminals();
+    if (index < 0 || index >= (int32_t) tensors.size() || !data
+        || size != ggml_nbytes(tensors[index]) || tensors[index]->buffer == nullptr) return false;
+    ggml_backend_tensor_set(tensors[index], data, 0, size);
+    return true;
+}
