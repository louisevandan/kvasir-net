+void llm_graph_result::apply_linkcpp_stage(const llm_graph_params & params) {
+    const int begin = params.linkcpp_layer_begin;
+    const int end   = params.linkcpp_layer_end;
+    const int n_layer = params.hparams.n_layer();
+    if (begin < 0 || end < 0) {
+        return;
+    }
+    GGML_ASSERT(0 <= begin && begin < end && end <= n_layer);
+
+    if (end == n_layer) {
+        std::unordered_set<ggml_tensor *> seen_terminals;
+        auto add_terminal = [&](ggml_tensor * tensor) {
+            if (tensor && seen_terminals.insert(tensor).second) {
+                t_linkcpp_terminals.push_back(tensor);
+            }
+        };
+        add_terminal(t_logits);
+        add_terminal(t_embd);
+        add_terminal(t_embd_pooled);
+        add_terminal(t_h_nextn);
+        for (const auto & item : t_sampled_logits) add_terminal(item.second);
+        for (const auto & item : t_candidates) add_terminal(item.second);
+        for (const auto & item : t_sampled) add_terminal(item.second);
+        for (const auto & item : t_sampled_probs) add_terminal(item.second);
+    }
+
+    // The coordinator rank must expose the same terminal tensor surface as a
+    // full graph. The external stage executor fills these allocated input
+    // slots after the local prefix graph completes, so existing llama.cpp
+    // logits/embedding/sampling extraction remains unchanged.
+    if (begin == 0 && end < n_layer) {
+        std::unordered_map<ggml_tensor *, ggml_tensor *> placeholders;
+        auto make_placeholder = [&](ggml_tensor * original) -> ggml_tensor * {
+            if (!original) return nullptr;
+            auto found = placeholders.find(original);
+            if (found != placeholders.end()) return found->second;
+            ggml_tensor * placeholder = ggml_new_tensor(
+                ctx_compute.get(), original->type, ggml_n_dims(original), original->ne);
+            memcpy(placeholder->nb, original->nb, sizeof(placeholder->nb));
+            ggml_format_name(placeholder, "%s", ggml_get_name(original));
+            ggml_set_input(placeholder);
+            ggml_set_output(placeholder);
+            placeholders.emplace(original, placeholder);
+            t_linkcpp_terminals.push_back(placeholder);
+            return placeholder;
+        };
+        t_logits      = make_placeholder(t_logits);
+        t_embd        = make_placeholder(t_embd);
+        t_embd_pooled = make_placeholder(t_embd_pooled);
+        t_h_nextn     = make_placeholder(t_h_nextn);
+        for (auto & item : t_sampled_logits) item.second = make_placeholder(item.second);
+        for (auto & item : t_candidates)     item.second = make_placeholder(item.second);
+        for (auto & item : t_sampled)        item.second = make_placeholder(item.second);
+        for (auto & item : t_sampled_probs)  item.second = make_placeholder(item.second);
+    }
+
+    ggml_tensor * output = t_logits ? t_logits : (t_embd_pooled ? t_embd_pooled : t_embd);
+    GGML_ASSERT(output != nullptr && "architecture has no graph output");
+
+    ggml_tensor ** nodes = ggml_graph_nodes(gf);
+    const int n_nodes = ggml_graph_n_nodes(gf);
+    std::unordered_map<ggml_tensor *, int> node_index;
+    node_index.reserve((size_t) n_nodes);
+    for (int i = 0; i < n_nodes; ++i) {
+        node_index[nodes[i]] = i;
+    }
+    std::unordered_map<ggml_tensor *, int> tensor_layer;
+    auto parse_layer = [](const ggml_tensor * tensor) {
+        const char * name = ggml_get_name(tensor);
+        const char * marker = strstr(name, "blk.");
+        if (marker != nullptr) {
+            marker += 4;
+        } else if (strncmp(name, "cache_", 6) == 0
+                && strchr("kvrs", name[6]) != nullptr
+                && name[7] == '_' && name[8] == 'l') {
+            // KV and recurrent state storage is created outside model graph
+            // callbacks, but llama.cpp names it with the owning layer. This
+            // provenance keeps zero/copy/write side effects in the same stage.
+            marker = name + 9;
+        } else {
+            return -1;
+        }
+        int layer = 0;
+        bool has_digit = false;
+        while (*marker >= '0' && *marker <= '9') {
+            has_digit = true;
+            layer = layer * 10 + (*marker++ - '0');
+        }
+        return has_digit && (*marker == '.' || *marker == '\0') ? layer : -1;
+    };
+    std::function<int(ggml_tensor *)> layer_of = [&](ggml_tensor * tensor) -> int {
+        if (tensor == nullptr) {
+            return -1;
+        }
+        auto cached = tensor_layer.find(tensor);
+        if (cached != tensor_layer.end()) {
+            return cached->second;
+        }
+        int layer = get_linkcpp_tensor_layer(tensor);
+        if (layer < 0) {
+            layer = parse_layer(tensor);
+        }
+        tensor_layer[tensor] = layer;
+        for (int j = 0; j < GGML_MAX_SRC; ++j) {
+            layer = std::max(layer, layer_of(tensor->src[j]));
+        }
+        tensor_layer[tensor] = layer;
+        return layer;
+    };
+    for (int i = 0; i < n_nodes; ++i) {
+        layer_of(nodes[i]);
+    }
+
+    auto storage_root = [](ggml_tensor * tensor) {
+        while (tensor && tensor->view_src) tensor = tensor->view_src;
+        return tensor;
+    };
+    std::unordered_map<ggml_tensor *, bool> primary_dependency;
+    std::function<bool(ggml_tensor *)> depends_on_primary = [&](ggml_tensor * tensor) -> bool {
+        if (!tensor) return false;
+        auto cached = primary_dependency.find(tensor);
+        if (cached != primary_dependency.end()) return cached->second;
+        bool depends = tensor == t_inp_tokens || tensor == t_inp_embd_raw || tensor == t_inp_embd;
+        primary_dependency[tensor] = depends;
+        for (int j = 0; j < GGML_MAX_SRC && !depends; ++j) {
+            depends = depends_on_primary(tensor->src[j]);
+        }
+        primary_dependency[tensor] = depends;
+        return depends;
+    };
+
+    auto is_storage_write = [](const ggml_tensor * tensor) {
+        return tensor->op == GGML_OP_CPY || tensor->op == GGML_OP_SET
+            || tensor->op == GGML_OP_SET_ROWS || tensor->op == GGML_OP_ACC;
+    };
+    auto same_storage = [](const ggml_tensor * a, const ggml_tensor * b) {
+        if (a == b) return true;
+        if (!a || !b) return false;
+        if (a->buffer && a->buffer == b->buffer && a->data && b->data) {
+            const uintptr_t a0 = (uintptr_t) a->data;
+            const uintptr_t b0 = (uintptr_t) b->data;
+            const uintptr_t a1 = a0 + ggml_nbytes(a);
+            const uintptr_t b1 = b0 + ggml_nbytes(b);
+            if (a0 < b1 && b0 < a1) return true;
+        }
+        return a->type == b->type
+            && ggml_are_same_shape(a, b)
+            && strlen(ggml_get_name(a)) > 0
+            && strcmp(ggml_get_name(a), ggml_get_name(b)) == 0;
+    };
+
+    auto cut_at = [&](int boundary_layer) {
+        std::vector<ggml_tensor *> cut;
+        std::unordered_set<ggml_tensor *> seen;
+        std::vector<ggml_tensor *> prefix_written_storage;
+        for (int i = 0; i < n_nodes; ++i) {
+            const int layer = layer_of(nodes[i]);
+            if (0 <= layer && layer < boundary_layer && is_storage_write(nodes[i])) {
+                ggml_tensor * root = storage_root(nodes[i]);
+                if (std::none_of(prefix_written_storage.begin(), prefix_written_storage.end(),
+                                 [&](ggml_tensor * other) { return same_storage(root, other); })) {
+                    prefix_written_storage.push_back(root);
+                }
+            }
+        }
+        for (int i = 0; i < n_nodes; ++i) {
+            if (layer_of(nodes[i]) < boundary_layer) {
+                continue;
+            }
+            for (int j = 0; j < GGML_MAX_SRC; ++j) {
+                ggml_tensor * src = nodes[i]->src[j];
+                auto source_it = node_index.find(src);
+                const bool written_state = std::any_of(
+                    prefix_written_storage.begin(), prefix_written_storage.end(),
+                    [&](ggml_tensor * written) { return same_storage(storage_root(src), written); });
+                const bool crossing_node = source_it != node_index.end()
+                    && layer_of(src) < boundary_layer
+                    && (layer_of(src) >= 0 || depends_on_primary(src) || written_state);
+                if (crossing_node
+                    && seen.insert(src).second) {
+                    cut.push_back(src);
+                }
+            }
+        }
+        std::sort(cut.begin(), cut.end(), [&](ggml_tensor * a, ggml_tensor * b) {
+            return node_index[a] < node_index[b];
+        });
+        return cut;
+    };
+
+    if (end < n_layer) {
+        t_linkcpp_outputs = cut_at(end);
+        GGML_ASSERT(!t_linkcpp_outputs.empty() && "graph has no outgoing stage cut-set");
+    }
+
+    if (begin > 0) {
+        t_linkcpp_inputs = cut_at(begin);
+        GGML_ASSERT(!t_linkcpp_inputs.empty() && "graph has no incoming stage cut-set");
+        LLAMA_LOG_DEBUG("linkcpp graph stage reserve: layers=[%d,%d) inputs=%zu\n",
+                begin, end, t_linkcpp_inputs.size());
