+            ggml_tensor * original = t_linkcpp_inputs[cut_index];
+            ggml_tensor * input = ggml_new_tensor(
+                ctx_compute.get(), original->type, ggml_n_dims(original), original->ne);
+            memcpy(input->nb, original->nb, sizeof(input->nb));
+            ggml_format_name(input, "linkcpp_in_%zu_%s", cut_index, ggml_get_name(original));
+            ggml_set_input(input);
+            t_linkcpp_input_nodes.push_back(input);
+            for (ggml_tensor *& outgoing : t_linkcpp_outputs) {
+                if (outgoing == original) {
+                    outgoing = input;
+                }
+            }
+            for (int i = 0; i < n_nodes; ++i) {
+                for (int j = 0; j < GGML_MAX_SRC; ++j) {
+                    if (nodes[i]->src[j] == original) {
+                        nodes[i]->src[j] = input;
+                    }
+                }
+            }
+        }
+    }
+
+    LLAMA_LOG_DEBUG("linkcpp graph stage: layers=[%d,%d) inputs=%zu outputs=%zu\n",
+            begin, end, t_linkcpp_inputs.size(), t_linkcpp_outputs.size());
+
+    // `nodes` aliases the graph's own node array, which ggml_graph_clear
+    // rewinds and ggml_build_forward_expand then overwrites from index 0.
+    // Reading it while refilling the same storage re-admits nodes this stage
+    // does not own: for begin == 0 the kept nodes sit at the front, so the
+    // entries the loop has not visited yet are the ones overwritten. Measured
+    // 2026-08-13: layers=[0,20) retained 340 unowned tensors worth 10,837 MiB,
+    // held by ffn_moe_down-34 (MUL_MAT_ID, layer 34), which is exactly the
