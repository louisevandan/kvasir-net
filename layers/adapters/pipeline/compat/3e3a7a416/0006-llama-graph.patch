+            ggml_build_forward_expand(gf, node);
+        }
+    }
+    if (end < n_layer) {
+        for (ggml_tensor * tensor : t_linkcpp_outputs) {
+            ggml_build_forward_expand(gf, tensor);
+            ggml_set_output(tensor);
+        }
+        if (begin == 0) {
+            for (ggml_tensor * tensor : t_linkcpp_terminals) {
+                ggml_build_forward_expand(gf, tensor);
+                ggml_set_output(tensor);
+            }
+        }
+    } else {
+        ggml_build_forward_expand(gf, output);
+        ggml_set_output(output);
+    }
+    if (end < n_layer && begin > 0) {
+        t_logits = nullptr;
+        t_embd = nullptr;
+        t_embd_pooled = nullptr;
+    }
+
+    // Audit: a stage must not keep unowned-layer weights reachable, because a
+    // reachable weight with no buffer becomes compute-buffer reservation.
+    // Off unless LINKER_STAGE_REACH_AUDIT is set; it walks every node.
+    static const bool reach_audit = getenv("LINKER_STAGE_REACH_AUDIT") != nullptr;
+    if (reach_audit) {
+        std::unordered_set<const ggml_tensor *> counted;
+        size_t unowned_bytes = 0, unowned_count = 0, owned_unbuffered = 0;
+        std::string worst_name;
+        std::string worst_holder;
+        size_t worst_bytes = 0;
+        ggml_tensor ** final_nodes = ggml_graph_nodes(gf);
+        const int final_count = ggml_graph_n_nodes(gf);
+        for (int i = 0; i < final_count; ++i) {
+            for (int j = -1; j < GGML_MAX_SRC; ++j) {
+                ggml_tensor * t = j < 0 ? final_nodes[i] : final_nodes[i]->src[j];
+                if (!t || t->buffer != nullptr || !counted.insert(t).second) continue;
+                const int tl = parse_layer(t);
+                if (tl >= 0 && (tl < begin || tl >= end)) {
+                    unowned_bytes += ggml_nbytes(t);
+                    ++unowned_count;
+                    if (ggml_nbytes(t) > worst_bytes) {
+                        worst_bytes = ggml_nbytes(t);
+                        worst_name = ggml_get_name(t);
+                        worst_holder = j < 0
+                            ? std::string("<graph node itself>")
+                            : std::string(ggml_get_name(final_nodes[i]))
+                                + " op=" + ggml_op_name(final_nodes[i]->op)
+                                + " holder_layer=" + std::to_string(layer_of(final_nodes[i]));
+                    }
+                } else if (tl >= 0) {
+                    ++owned_unbuffered;
+                }
+            }
+        }
+        LLAMA_LOG_INFO("linkcpp stage reach: layers=[%d,%d) unowned=%zu unowned_mib=%.2f owned_unbuffered=%zu worst=%s worst_mib=%.2f holder=%s\n",
+                begin, end, unowned_count, (double) unowned_bytes / (1024.0*1024.0),
+                owned_unbuffered, worst_name.empty() ? "none" : worst_name.c_str(),
+                (double) worst_bytes / (1024.0*1024.0), worst_holder.empty() ? "none" : worst_holder.c_str());
+    }
+}
+
+bool llm_graph_result::set_linkcpp_inputs(const std::vector<std::vector<uint8_t>> & payloads) {
+    if (payloads.size() != t_linkcpp_input_nodes.size()) {
+        return false;
+    }
+    for (size_t i = 0; i < payloads.size(); ++i) {
+        ggml_tensor * tensor = t_linkcpp_input_nodes[i];
+        if (payloads[i].size() != ggml_nbytes(tensor) || tensor->buffer == nullptr) {
+            return false;
+        }
+        ggml_backend_tensor_set(tensor, payloads[i].data(), 0, payloads[i].size());
+    }
+    return true;
+}
