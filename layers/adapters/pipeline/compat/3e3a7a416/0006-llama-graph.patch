+// ---- linkcpp MoE expert dispatch hook (private fork) ------------------------
+// See docs/design/moe-expert-sharding.md. For the flagged layer, build_moe_ffn
+// hands the routed-expert FFN to this callback instead of computing it locally.
+static llama_linkcpp_moe_dispatch_t g_linkcpp_moe_dispatch       = nullptr;
+static void *                       g_linkcpp_moe_dispatch_ud    = nullptr;
+static int32_t                      g_linkcpp_moe_dispatch_layer = -1;
+
+extern "C" void llama_linkcpp_set_moe_dispatch(
+        llama_linkcpp_moe_dispatch_t fn, void * user_data, int32_t layer) {
+    g_linkcpp_moe_dispatch       = fn;
+    g_linkcpp_moe_dispatch_ud    = user_data;
+    g_linkcpp_moe_dispatch_layer = layer;
+}
+
+// ggml custom op: fills dst [n_embd, n_expert_used, n_tokens] from
+// src0 = cur [n_embd, 1, n_tokens] and src1 = sel [n_expert_used, n_tokens].
+static void linkcpp_moe_dispatch_op(ggml_tensor * dst, int ith, int nth, void * ud) {
+    if (ith != 0) return;
+    (void) nth;
+    const int32_t       il = (int32_t) (intptr_t) ud;
+    const ggml_tensor * a  = dst->src[0];
+    const ggml_tensor * b  = dst->src[1];
+    if (g_linkcpp_moe_dispatch) {
+        g_linkcpp_moe_dispatch(il, (int32_t) dst->ne[0], (int32_t) dst->ne[1], (int32_t) dst->ne[2],
+                               (const float *) a->data, (const int32_t *) b->data,
+                               (float *) dst->data, g_linkcpp_moe_dispatch_ud);
+    }
+}
 
